<!Doctype html>
<html>
<head><meta charset="utf-8"><title>編集</title></head>
<body>
  <h2><%= data.name %> の編集</h2>
  <form action="/premier/update/<%= id %>" method="POST">
    チーム名: <input type="text" name="name" value="<%= data.name %>"><br>
    都市: <input type="text" name="city" value="<%= data.city %>"><br>
    収容人数: <input type="text" name="capacity" value="<%= data.capacity %>"><br>
    順位: <input type="text" name="rank" value="<%= data.rank %>"><br>
    <input type="submit" value="更新">
  </form>
  <a href="/premier">戻る</a>
</body>
</html>