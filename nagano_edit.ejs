<!Doctype html>
<html>
<head><meta charset="utf-8"><title>編集</title></head>
<body>
  <h2><%= data.name %> の編集</h2>
  <form action="/nagano/update/<%= id %>" method="POST">
    市町村名: <input type="text" name="name" value="<%= data.name %>"><br>
    エリア: <input type="text" name="area" value="<%= data.area %>"><br>
    人口: <input type="text" name="population" value="<%= data.population %>"><br>
    距離: <input type="text" name="distance" value="<%= data.distance %>"><br>
    <input type="submit" value="更新">
  </form>
  <a href="/nagano">戻る</a>
</body>
</html>